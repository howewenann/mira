# MIRA reads .env from the workspace where you run `mira`.
# Copy this file to .env, then keep exactly one provider block active.

# Shared runtime settings
MIRA_TOOL_OUTPUT_CHARS=240
# MIRA_SESSION_DIR=.mira/_sessions

# Optional generation settings
# MIRA_LLM_TEMPERATURE=0.2
# MIRA_LLM_MAX_TOKENS=4096
# MIRA_LLM_TOP_P=0.95
# Strict JSON object passed through ChatAnyLLM.model_kwargs to AnyLLM.
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"none"}
# Safe effective context cap/fallback. MIRA uses the minimum of this value and
# provider/model-profile context metadata when available.
MIRA_LLM_CONTEXT_TOKENS=32768

# LM Studio, the default local provider
MIRA_LLM_PROVIDER=lmstudio
MIRA_LLM_MODEL=local-model
MIRA_LLM_BASE_URL=http://localhost:1234/v1
MIRA_LLM_API_KEY=lm-studio
# Optional when the loaded model supports it:
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"none"}

# Ollama (optional adapter: pip install "any-llm-sdk[ollama]")
# MIRA_LLM_PROVIDER=ollama
# MIRA_LLM_MODEL=qwen3.5:9b
# MIRA_LLM_BASE_URL=http://localhost:11434
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"low"}

# OpenAI
# MIRA_LLM_PROVIDER=openai
# MIRA_LLM_MODEL=gpt-5.6-terra
# MIRA_LLM_API_KEY=sk-...
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"low"}

# Anthropic / Claude
# MIRA_LLM_PROVIDER=anthropic
# MIRA_LLM_MODEL=claude-sonnet-5
# MIRA_LLM_API_KEY=sk-ant-...
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"low"}
# Claude Sonnet 5 rejects non-default temperature/top_p/top_k; leave them unset.

# Gemini
# MIRA_LLM_PROVIDER=gemini
# MIRA_LLM_MODEL=gemini-2.5-flash
# MIRA_LLM_API_KEY=...
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"low"}

# Groq (optional adapter: pip install "any-llm-sdk[groq]")
# MIRA_LLM_PROVIDER=groq
# MIRA_LLM_MODEL=openai/gpt-oss-120b
# MIRA_LLM_API_KEY=gsk_...
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"low","reasoning_format":"hidden"}

# OpenRouter
# MIRA_LLM_PROVIDER=openrouter
# MIRA_LLM_MODEL=openai/gpt-5.6-terra
# MIRA_LLM_API_KEY=sk-or-...
# MIRA_LLM_MODEL_KWARGS={"reasoning_effort":"low"}

# Optional rubric grader profile
# Blank rubric fields inherit the main profile when the provider is unchanged.
# Rubric JSON kwargs shallow-merge over main kwargs.
# MIRA_RUBRIC_LLM_MODEL=prism-ml/bonsai-27b
# MIRA_RUBRIC_LLM_MAX_TOKENS=4096
# MIRA_RUBRIC_LLM_MODEL_KWARGS={"reasoning_effort":"none"}

# A different rubric provider starts a fresh profile; its model is required and
# main credentials, endpoint, sampling values, and JSON kwargs are not inherited.
# MIRA_RUBRIC_LLM_PROVIDER=openai
# MIRA_RUBRIC_LLM_MODEL=gpt-5.6-terra
# MIRA_RUBRIC_LLM_API_KEY=sk-...
# MIRA_RUBRIC_LLM_BASE_URL=https://api.openai.com/v1
# MIRA_RUBRIC_LLM_TEMPERATURE=0.1
# MIRA_RUBRIC_LLM_MAX_TOKENS=4096
# MIRA_RUBRIC_LLM_TOP_P=1
# MIRA_RUBRIC_LLM_CONTEXT_TOKENS=32768
# MIRA_RUBRIC_LLM_MODEL_KWARGS={"reasoning_effort":"low"}
