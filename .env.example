# MIRA reads .env from the workspace where you run `mira`.
# Model profiles belong in .mira/models.yml; keep secrets here and reference
# them from that registry as ${NAME}.

# Provider secrets used by model profiles
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Secrets used by MCP configuration
# REMOTE_MCP_TOKEN=...

# Process/runtime values
MIRA_TOOL_OUTPUT_CHARS=240
# MIRA_SESSION_DIR=.mira/_sessions
# MIRA_LMSTUDIO_METADATA_TIMEOUT=2.0
