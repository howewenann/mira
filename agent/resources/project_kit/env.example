# MIRA loads <project>/.env, not this file.
# Copy only the variables you need into the real project .env. Never commit
# real secrets.

# Model provider keys
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...

# MCP values referenced from .mira/mcp/mcp.json as ${NAME}
# REMOTE_MCP_TOKEN=...

# LangSmith tracing
# LANGSMITH_API_KEY=...
# LANGSMITH_WORKSPACE_ID=...

# Phoenix reads this itself. A separate Phoenix process does not inherit
# values from MIRA, so start it with: dotenv run -- phoenix serve
PHOENIX_WORKING_DIR=.mira/_phoenix

# MIRA runtime
MIRA_TOOL_OUTPUT_CHARS=240
# MIRA_SESSION_DIR=.mira/_sessions
# MIRA_LMSTUDIO_METADATA_TIMEOUT=2.0
