Screen {
    background: #0c0f10;
    color: #e8edef;
}

#app-shell {
    height: 100%;
    width: 100%;
}

#main-panel {
    width: 1fr;
    min-width: 24;
    height: 100%;
}

#session-sidebar {
    width: 42;
    min-width: 30;
    height: 100%;
    padding: 0 1;
    border: solid #2d5661;
    border-right: heavy #5bb8b1;
    background: #101516;
}

#session-sidebar-header {
    layout: horizontal;
    height: 1;
    width: 1fr;
    margin: 0 0 1 0;
}

#session-sidebar-title {
    width: 1fr;
    height: 1;
    color: #eef7f8;
    text-style: bold;
}

#new-chat {
    width: 7;
    min-width: 7;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: #7ce3dc;
    text-style: bold;
}

#new-chat:focus {
    background: #1b3036;
    color: #eef7f8;
}

#sessions {
    width: 1fr;
    height: 1fr;
    padding: 0;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#sessions > .session-row {
    height: 4;
    padding: 0 1;
    margin: 0 0 1 0;
    color: #b8c1c7;
}

#sessions > .session-row.--highlight,
#sessions > .session-row.active {
    background: #1b3036;
    color: #eef7f8;
}

#sessions > .session-row.active {
    border-left: solid #d2a957;
}

.session-label {
    height: 3;
}

.session-empty {
    color: #7d8b95;
}

#status-row {
    height: 1;
    width: 1fr;
    padding: 0 1;
    background: #17313a;
    color: #eef7f8;
}

#status {
    width: 1fr;
    height: 1;
}

#artifact-status-button,
#mcp-status-button,
#issues-button {
    width: 13;
    min-width: 13;
    max-width: 13;
    height: 1;
    padding: 0;
    border: none;
    text-style: bold;
}

#artifact-status-button {
    display: none;
}

#artifact-status-button.plan-artifact {
    background: #394329;
    color: #D0E19A;
}

#artifact-status-button.goal-artifact {
    background: #46354D;
    color: #E0B5EA;
}

#artifact-status-button.plan-artifact:hover,
#artifact-status-button.plan-artifact:focus,
#artifact-status-button.plan-artifact.-active {
    background: #394329;
    color: #D0E19A;
    tint: transparent;
}

#artifact-status-button.goal-artifact:hover,
#artifact-status-button.goal-artifact:focus,
#artifact-status-button.goal-artifact.-active {
    background: #46354D;
    color: #E0B5EA;
    tint: transparent;
}

#artifact-status-button:disabled {
    opacity: 45%;
}

#issues-button {
    display: none;
    background: #6b4f20;
    color: #fff0bd;
}

IssuesScreen {
    align: center middle;
    background: rgba(4, 7, 8, 0.72);
}

#issues-dialog {
    width: 76;
    max-width: 94%;
    height: 80%;
    min-height: 18;
    padding: 1 2;
    border: heavy #d2a957;
    background: #101516;
}

#issues-title-row {
    height: 3;
    width: 1fr;
}

#issues-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: #fff0bd;
    text-style: bold;
}

#issues-scroll {
    height: 1fr;
    scrollbar-color: #d2a957;
    scrollbar-background: #20272b;
}

#mcp-status-button {
    display: none;
    background: #386B69;
    color: #D2F0ED;
}

#mcp-status-button:hover,
#mcp-status-button:focus,
#mcp-status-button.-active {
    background: #386B69;
    color: #D2F0ED;
    tint: transparent;
}

#telemetry-row {
    height: 1;
    width: 1fr;
    padding: 0 1;
    background: #101b1f;
    color: #b8c1c7;
}

#model-settings-button {
    width: auto;
    max-width: 60%;
    min-width: 14;
    height: 1;
    border: none;
    padding: 0 1;
    content-align: left middle;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    background: #8897E8;
    color: #0C0F10;
    text-style: bold;
}

#model-settings-button:focus {
    background: #A8B3FF;
    color: #0C0F10;
    text-style: bold;
}

#telemetry-values {
    width: 1fr;
    height: 1;
    content-align: right middle;
}

MCPPanelScreen {
    align: center middle;
    background: rgba(4, 7, 8, 0.72);
}

#mcp-dialog {
    width: 88;
    max-width: 96%;
    height: 84%;
    min-height: 18;
    padding: 1 2;
    border: heavy #5bb8b1;
    background: #101516;
}

#mcp-title-row { height: 3; }
#mcp-title { width: 1fr; height: 3; content-align: left middle; color: #d6fff6; text-style: bold; }
#mcp-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#mcp-actions {
    height: 3;
    align-horizontal: right;
}

#mcp-actions Button {
    min-width: 12;
    margin-left: 1;
}

.mcp-server-card {
    width: 1fr;
    height: auto;
    margin: 0 1 1 0;
    padding: 0 1;
    border: solid #3e5962;
    background: #151f22;
}
.mcp-server-top {
    width: 1fr;
    height: 1;
}

.mcp-server-header {
    width: 1fr;
    height: 1;
    border: none;
    background: #1b3036;
    color: #eef7f8;
    content-align: left middle;
    text-style: bold;
}

.mcp-status-badge {
    width: auto;
    min-width: 14;
    max-width: 26;
    height: 1;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
    background: #263137;
    color: #c6d0d5;
}

.mcp-status-badge.available { background: #194b32; color: #a9f0b1; }
.mcp-status-badge.warning { background: #5a451e; color: #fff0ad; }
.mcp-status-badge.failed { background: #5b272a; color: #ffb3b3; }
.mcp-status-badge.disabled { background: #30383d; color: #aeb8be; }
.mcp-status-badge.transient { background: #263f60; color: #bcd1f5; }

.mcp-capabilities {
    width: 1fr;
    height: auto;
    padding: 0;
    background: transparent;
    border: none;
}
.mcp-capabilities > CollapsibleTitle {
    width: 1fr;
    height: 1;
    padding: 0;
    color: #eef7f8;
}
.mcp-capabilities > CollapsibleTitle:focus {
    background: transparent;
    color: #eef7f8;
    text-style: none;
}
.mcp-capabilities > CollapsibleTitle:hover,
.mcp-capabilities > CollapsibleTitle:focus:hover {
    background: #1b3036;
    color: #eef7f8;
}
.mcp-capabilities > Contents {
    padding: 1 1 0 1;
}

.mcp-controls { height: 1; align-horizontal: right; }
.mcp-controls Button {
    min-width: 10;
    height: 1;
    margin-left: 1;
    padding: 0 1;
    border: none;
}
.mcp-detail-section { height: auto; padding: 1; margin-bottom: 1; background: #101719; color: #c4cdd2; }
.mcp-attention { height: auto; padding: 0 1; margin-bottom: 1; }
.mcp-attention.failed { border-left: solid #ff8f8f; background: #301d1f; color: #ffc2c2; }
.mcp-attention.warning { border-left: solid #e2b44f; background: #332a18; color: #fff0ad; }

#chat-log {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: solid #2d5661;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#autocomplete-input {
    width: 100%;
    height: auto;
    layers: base resize;
}

#prompt-resize-handle {
    layer: resize;
    dock: left;
    width: 1;
    height: 1;
    offset: 1 0;
    background: transparent;
    color: #5bb8b1;
    pointer: ns-resize;
}

#prompt-resize-handle.-prompt-disabled {
    opacity: 50%;
}

#prompt-resize-handle:hover {
    color: #7ce3dc;
    opacity: 100%;
}

#autocomplete-options {
    display: none;
    width: 100%;
    height: auto;
    max-height: 12;
    border: solid #5bb8b1;
    background: #101516;
    color: #e8edef;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#autocomplete-options > .option-list--option-highlighted {
    background: #1b3036;
    color: #eef7f8;
    text-style: bold;
}

#prompt {
    height: 5;
    border: heavy #5bb8b1;
    padding: 0 1;
    background: transparent;
}

#subagents-panel {
    display: none;
    height: auto;
    max-height: 14;
    padding: 0;
    border: none;
    background: #101516;
    color: #ECE7FF;
}

#subagents-panel-row {
    height: auto;
}

#subagents-collapsible,
#subagents-groups,
#subagents-tasks,
#subagents-tasks-column {
    border: none;
    background: transparent;
}

#subagents-collapsible {
    width: 1fr;
    height: auto;
    padding: 0;
}

#subagents-collapsible:focus-within,
#subagents-groups:focus,
#subagents-tasks:focus {
    background-tint: transparent;
}

#subagents-collapsible > CollapsibleTitle {
    width: 1fr;
    padding: 0 1;
    border-top: solid #B7A4E8;
    border-left: solid #B7A4E8;
    border-bottom: solid #B7A4E8;
    color: #ECE7FF;
    text-style: bold;
}

#subagents-collapsible > CollapsibleTitle:focus {
    background: transparent;
}

#subagents-collapsible > CollapsibleTitle:hover,
#subagents-collapsible > CollapsibleTitle:focus:hover {
    background: transparent;
    color: #ECE7FF;
}

#subagents-collapsible > Contents {
    padding: 0;
}

#subagents-close-cell {
    width: 5;
    min-width: 5;
    height: 3;
    min-height: 3;
    padding: 0;
    border-top: solid #B7A4E8;
    border-right: solid #B7A4E8;
    border-bottom: solid #B7A4E8 !important;
    background: transparent;
}

#subagents-panel-close {
    width: 1fr;
    min-width: 1;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: #d2d8dc;
}

#subagents-panel-close:focus {
    background: transparent;
    color: #d2d8dc;
}

#subagents-panel-close:hover,
#subagents-panel-close:focus:hover,
#subagents-panel-close.-active {
    background: transparent;
    color: #d2d8dc;
    tint: transparent;
}

#subagents-panel-body {
    padding: 0 1;
    overflow-x: hidden;
}

#subagents-groups-column {
    width: 25%;
    min-width: 10;
    max-width: 28;
    padding: 0 1 0 0;
    margin: 0 1 0 0;
    border-right: solid #4a5360;
}

#subagents-groups-label {
    width: 1fr;
    text-align: left;
    color: #b8c1c7;
    text-style: bold;
}

#subagents-groups,
#subagents-tasks {
    height: 1fr;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#subagents-tasks-column {
    width: 1fr;
    height: 1fr;
}

#subagents-tasks-header {
    width: 1fr;
    height: 1;
    grid-size: 3 1;
    grid-columns: 1fr 11 7;
    grid-rows: 1;
    padding-right: 1;
    color: #b8c1c7;
    text-style: bold;
}

#subagents-task-heading,
#subagents-status-heading {
    padding-left: 1;
}

#subagents-time-heading {
    text-align: center;
}

#subagents-groups > .option-list--option-highlighted,
#subagents-groups:focus > .option-list--option-highlighted {
    background: transparent;
    color: #b8c1c7;
    text-style: none;
}

#subagents-groups > .option-list--option-hover,
#subagents-groups:focus > .option-list--option-hover {
    background: transparent;
    color: #b8c1c7;
    text-style: none;
}

#subagents-tasks {
    width: 1fr;
    overflow-x: hidden;
    scrollbar-size-horizontal: 0;
}

#subagents-tasks > .datatable--hover,
#subagents-tasks > .datatable--header-hover,
#subagents-tasks > .datatable--cursor,
#subagents-tasks > .datatable--header-cursor {
    background: transparent;
}

#prompt-panel {
    width: 100%;
    height: auto;
    max-height: 90%;
    padding: 1;
    background: #11181b;
    border: solid #d2a957;
}

#prompt-panel-title {
    height: 1;
    margin-bottom: 1;
    text-style: bold;
    color: #eef7f8;
}

#prompt-panel-body {
    height: auto;
    min-height: 3;
    max-height: 6;
    padding: 0 1;
    border: solid #3c4a50;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#prompt-panel-message {
    color: #e8edef;
}

#prompt-panel-input {
    height: 3;
    margin-top: 1;
    border: heavy #5bb8b1;
    padding: 0 1;
    background: #101516;
}

#prompt-panel-editor {
    height: 8;
    margin-top: 1;
    border: solid #4a5360;
}

#prompt-panel-buttons {
    layout: vertical;
    width: 100%;
    height: auto;
    margin-top: 1;
}

.vertical-choices #prompt-panel-buttons {
    max-height: 4;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

Horizontal.prompt-panel-button-row {
    layout: horizontal;
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
}

Button.prompt-panel-button {
    min-width: 12;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    content-align: center middle;
    text-align: center;
}

Button.prompt-panel-button:focus {
    background: #d2a957;
    color: #0c0f10;
    text-style: bold;
}

.vertical-choices Button.prompt-panel-button {
    content-align: left middle;
    text-align: left;
}

.message {
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid #3c4a50;
    color: #e8edef;
}

.message.user {
    border: solid #D6B35A;
}

.message.assistant,
.message.startup {
    border: solid #5BB8B1;
}

.message.assistant {
    height: auto;
}

.assistant-body {
    height: auto;
}

.assistant-actions {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin-top: 1;
    align-horizontal: left;
}

Button.assistant-copy {
    width: 10;
    min-width: 10;
    max-width: 10;
}

Button.assistant-display {
    width: 12;
    min-width: 12;
    max-width: 12;
}

Button.assistant-copy,
Button.assistant-display {
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    content-align: center middle;
    text-align: center;
    background: #151f22;
    color: #b8d6d5;
    text-style: none;
}

Button.assistant-display {
    margin-left: 1;
}

Button.assistant-copy:focus,
Button.assistant-copy:hover,
Button.assistant-display:focus,
Button.assistant-display:hover {
    border: none;
    background: #1b3036;
    color: #eef7f8;
    text-style: none;
}

.message.reasoning {
    border: solid #82909A;
    color: #B8C2C9;
}

.message.status {
    border: solid #7D9BD1;
    color: #DCE6FA;
}

.message.info {
    border: solid #6CB6FF;
    color: #DCEEFF;
}

.message.warning {
    border: solid #E07A3F;
    color: #F5C7A9;
}

.message.error {
    border: solid #D96B66;
    color: #FFD9D6;
}

.message.muted {
    border: solid #7A858C;
    color: #AEB8BE;
}

.message.heading {
    border: solid #5bb8b1;
    color: #eef7f8;
}

.message.plan {
    height: auto;
    border: solid #A0B86B;
    color: #EEF5D8;
}

.plan-body {
    height: auto;
}

.plan-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

Button.plan-action {
    min-width: 12;
    width: auto;
    height: 1;
    min-height: 1;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

Button.plan-action:focus {
    background: #d2a957;
    color: #0c0f10;
    text-style: bold;
}

.message.goal {
    height: auto;
    border: solid #C58FD6;
    color: #F1DCF5;
}

.message.correction {
    border: solid #7D9BD1;
    color: #DCE6FA;
}

.message.rubric {
    height: auto;
    border: solid #C58FD6;
    color: #F1DCF5;
}

.rubric-header,
.rubric-phase-heading,
.rubric-result,
.rubric-no-tools,
.rubric-verifier-status,
.rubric-grader-status,
.rubric-tool-rows,
.rubric-tool-row {
    width: 1fr;
    height: auto;
    padding: 0;
    margin: 0;
    background: transparent;
}

.rubric-phase-heading {
    margin-top: 1;
}

.rubric-tool-row {
    border: none;
}

.rubric-tool-args > CollapsibleTitle {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.rubric-tool-output,
.rubric-tool-status,
.rubric-verifier-status,
.rubric-grader-status {
    width: 1fr;
    height: 1;
    padding: 0;
    margin: 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.rubric-tool-output {
    color: #B8C1C7;
}

.rubric-tool-status,
.rubric-verifier-status,
.rubric-grader-status {
    color: #98A5AC;
}

.goal-body {
    height: auto;
}

.goal-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

Button.goal-action {
    min-width: 12;
    width: auto;
    height: 1;
    min-height: 1;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

Button.goal-action:focus {
    background: #C58FD6;
    color: #0c0f10;
    text-style: bold;
}

.message.command {
    border: solid #6F7782;
    color: #CBD1D5;
}

#settings-overlay {
    layer: overlay;
    width: 100%;
    height: 100%;
    align: center middle;
    background: #0c0f10 70%;
}

#settings-window {
    width: 110;
    max-width: 98%;
    height: auto;
    max-height: 92%;
    padding: 1 3 1 3;
    border: solid #5bb8b1;
    background: #101516;
}

.settings-top-row {
    height: 3;
    width: 1fr;
}

.settings-title {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
    color: #eef7f8;
    text-style: bold;
}

.panel-close {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 0 0 0 1;
    color: #d2d8dc;
    background: transparent;
    border: heavy #56616a;
}

.panel-close:focus {
    color: #d2d8dc;
    background: transparent;
    border: heavy #56616a;
}

.settings-body {
    height: auto;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

.settings-section {
    height: 1;
    margin: 0;
    width: auto;
    padding: 0;
    text-style: bold;
    content-align: left middle;
}

.settings-section.system {
    color: #d18aa6;
}

.settings-section.inbuilt {
    color: #d2a957;
}

.settings-section.custom {
    color: #7FBE72;
}

.settings-section.inbuilt,
.settings-section.execute-env {
    margin-top: 1;
}

.settings-section.system,
.settings-section.custom,
.settings-access-landing-heading {
    margin-top: 2;
}

.settings-section.execute-env {
    color: #cba6f7;
}

.settings-section.model-context {
    color: #D9956A;
    margin-top: 2;
}

.settings-section.model-assignments {
    color: #8897E8;
    margin-top: 1;
}

.settings-section.subagents {
    color: #93A4C3;
    margin-top: 2;
}

.settings-row {
    height: 2;
    width: auto;
}

.settings-child-label {
    padding-left: 3;
    color: #5bb8b1;
}

.settings-wide-row {
    height: 3;
}

#settings-execute-env-switcher,
.settings-execute-env-page {
    height: auto;
}

.settings-header-row {
    height: 1;
}

.settings-label,
.settings-column-label.name {
    height: 1fr;
    content-align: left middle;
    color: #7ce3dc;
}

.settings-label {
    width: 30;
    min-width: 20;
}

.settings-column-label.name,
.settings-policy-row > .settings-label,
.settings-value-row > .settings-label {
    width: 44;
    min-width: 20;
}

.settings-column-label {
    color: #aeb8be;
    text-style: bold;
}

.settings-column-label.enabled,
.settings-column-label.always {
    width: 12;
    min-width: 12;
    margin: 0 2 0 0;
    height: 1fr;
    content-align: center middle;
}

.settings-mode {
    width: 12;
    min-width: 12;
    margin: 0 2 0 0;
    height: 1fr;
    content-align: center middle;
}

.settings-toggle {
    min-width: 12;
    width: 12;
    height: 1;
    margin: 0 2 1 0;
    border: none;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

.settings-toggle.on {
    color: #e8fffb;
    background: #14524f;
    border: none;
}

.settings-toggle.off {
    color: #d2d8dc;
    background: #20272b;
    border: none;
}

.settings-toggle.locked {
    color: #7a858c;
    background: #151a1d;
    border: none;
}

.settings-toggle:focus {
    border: none;
    text-style: bold;
}

.settings-toggle.on:focus {
    color: #e8fffb;
    background: #14524f;
}

.settings-toggle.off:focus {
    color: #d2d8dc;
    background: #20272b;
}

.settings-empty,
.settings-status {
    color: #aeb8be;
}

.settings-select,
.settings-access-policy {
    width: 56;
    min-width: 36;
    height: 3;
    margin: 0 1 0 0;
}

.settings-tracing-row > .settings-config-button {
    width: 12;
    min-width: 12;
    margin: 0 2 1 0;
}

.settings-config-action {
    width: 16;
    min-width: 16;
    margin: 0 1 1 0;
}

.settings-config-action.settings-reload-button {
    width: 20;
    min-width: 20;
}

.settings-tracing-row > .settings-config-button,
.settings-config-action {
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    text-style: bold;
}

.settings-tracing-row > .settings-config-button:focus,
.settings-tracing-row > .settings-config-button:hover {
    border: none;
    background: #14524f;
    color: #e8fffb;
    text-style: bold;
}

.settings-tracing-row > .settings-config-button {
    background: #14524f;
    color: #e8fffb;
}

.settings-config-action {
    background: #1b3036;
    color: #eef7f8;
}

.settings-config-action:focus,
.settings-config-action:hover {
    border: none;
    background: #1b3036;
    background-tint: transparent;
    color: #eef7f8;
    text-style: bold;
}

#settings-footer {
    width: 1fr;
    height: 2;
}

#settings-footer > .settings-status {
    width: 1fr;
    height: 1;
    margin-top: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#settings-footer > .settings-footer-reload {
    margin: 1 0 0 1;
}

#settings-tracing-detail {
    padding-top: 0;
}

.settings-tracing-heading,
.settings-tracing-label {
    height: 1;
    margin-bottom: 1;
}

.settings-tracing-label {
    color: #aeb8be;
    text-style: bold;
}

.settings-tracing-help {
    color: #8f9aa1;
    height: 2;
    margin-bottom: 1;
}

.settings-tracing-profile {
    width: 1fr;
    height: 3;
    margin-bottom: 1;
}

.settings-tracing-preview {
    width: 1fr;
    height: auto;
    min-height: 5;
    margin-bottom: 1;
    padding: 0 1;
    border: solid #3c4a50;
    background: #151a1d;
    color: #d2d8dc;
}

.settings-select > SelectCurrent,
.settings-tracing-profile > SelectCurrent,
.settings-access-policy {
    border: solid #56616a;
    color: #e8fffb;
    background: #151a1d;
}

.settings-select > SelectCurrent > Static#label,
.settings-tracing-profile > SelectCurrent > Static#label {
    color: #e8fffb;
}

.settings-select:focus > SelectCurrent,
.settings-tracing-profile:focus > SelectCurrent,
.settings-access-policy:focus {
    border: solid #5bb8b1;
}

.settings-select > SelectOverlay,
.settings-select > SelectOverlay:focus,
.settings-tracing-profile > SelectOverlay,
.settings-tracing-profile > SelectOverlay:focus {
    border: solid #5bb8b1;
    color: #e8fffb;
    background: #151a1d;
}

.settings-select > SelectOverlay > .option-list--option-highlighted,
.settings-select > SelectOverlay:focus > .option-list--option-highlighted,
.settings-tracing-profile > SelectOverlay > .option-list--option-highlighted,
.settings-tracing-profile > SelectOverlay:focus > .option-list--option-highlighted {
    color: #e8fffb;
    background: #14524f;
    text-style: bold;
}

.settings-input {
    width: 56;
    min-width: 36;
    height: 3;
    margin: 0 1 0 0;
    border: solid #56616a;
    color: #e8fffb;
    background: #151a1d;
}

.settings-input:focus {
    border: solid #5bb8b1;
}

.settings-input:disabled {
    border: solid #3c4a50;
    color: #7a858c;
}

.rubric-iterations-row {
    height: 2;
}

.settings-input.rubric-iterations-input,
.settings-input.planning-response-status-retries-input {
    width: 12;
    min-width: 12;
    height: 1;
    margin: 0 2 1 0;
    border: none;
}

.settings-input.settings-context-limit-input {
    width: 24;
    min-width: 24;
}

.settings-context-row > .settings-label {
    width: 30;
}

.settings-subagent-header > .settings-column-label.name,
.settings-subagent-row > .settings-label {
    width: 28;
    min-width: 20;
    margin-right: 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.settings-subagent-row > .settings-toggle {
    margin: 1 2 1 0;
}

.settings-subagent-header > .settings-column-label.model,
.settings-subagent-model-select {
    width: 1fr;
    min-width: 22;
}

.settings-subagent-header > .settings-column-label.model {
    max-width: 44;
}

.settings-subagent-model-select {
    max-width: 43;
}

.settings-subagent-header > .settings-column-label.model {
    height: 1fr;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

.settings-subagent-model-select > SelectCurrent > Static#label {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#settings-tabs { height: 3; }
#settings-switcher { height: 1fr; }
.settings-tab { width: 18; height: 3; border: none; background: #151a1d; color: #aeb8be; }
.settings-tab.active { background: #1b3036; color: #eef7f8; text-style: bold; }
.settings-body { height: 1fr; }
#settings-access-switcher,
#settings-access-landing,
#settings-access-detail { height: 1fr; }
.settings-access-heading {
    height: 1;
    color: #D8DEE9;
    text-style: bold;
}
.settings-access-description {
    height: 1;
    margin-bottom: 1;
    color: #aeb8be;
}
.settings-access-policy {
    margin: 0;
    content-align: left middle;
}
Button.settings-access-back {
    width: 10;
    min-width: 10;
    max-width: 10;
    height: 1;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: #1b3036;
    color: #eef7f8;
    text-style: bold;
}
Button.settings-access-back:focus,
Button.settings-access-back:hover {
    border: none;
    background: #1b3036;
    background-tint: transparent;
    color: #eef7f8;
    text-style: bold;
}
.settings-access-policy:focus {
    background: #151a1d;
    background-tint: transparent;
    color: #e8fffb;
    text-style: bold;
}
.settings-access-detail-heading { margin: 1 0 1 0; }
.settings-access-guidance,
.settings-mcp-guidance {
    width: 72;
    height: auto;
    margin-bottom: 2;
    padding: 0 1;
    border-left: solid #5bb8b1;
    background: #122023;
    color: #b8c1c7;
}
.settings-mcp-guidance {
    margin: 1 0 2 0;
}
.settings-section.settings-access-section,
.settings-mcp-server-title.settings-access-section { margin: 0; }
.settings-section.settings-access-section.subsequent,
.settings-mcp-server-title.settings-access-section.subsequent { margin-top: 1; }
.settings-mcp-server-group {
    height: auto;
    margin: 1 0 0 0;
    background: transparent;
}

.settings-mcp-server-group.first {
    margin-top: 0;
}

.settings-mcp-empty {
    margin-top: 0;
}

.settings-mcp-server-title {
    height: 1;
    color: #6CB6FF;
    text-style: bold;
}

.settings-mcp-tool-header {
    margin-top: 1;
}

.settings-mcp-tool-empty {
    height: 2;
}

.settings-custom-tool-row > .settings-label,
.settings-mcp-tool-row > .settings-label {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.settings-custom-tool-header > .settings-column-label.name,
.settings-custom-tool-row > .settings-label,
.settings-mcp-server-header > .settings-column-label.name,
.settings-mcp-server-policy-row > .settings-label,
.settings-mcp-tool-header > .settings-column-label.name,
.settings-mcp-tool-row > .settings-label {
    width: 42;
    min-width: 18;
    margin-right: 2;
}

.settings-input.rubric-iterations-input:focus,
.settings-input.rubric-iterations-input:disabled,
.settings-input.planning-response-status-retries-input:focus,
.settings-input.planning-response-status-retries-input:disabled {
    border: none;
}

.message.tool-call {
    height: auto;
    border: solid #8FA3B8;
}

.tool-args-collapsible {
    width: 1fr;
    height: auto;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
}

.tool-args-collapsible > CollapsibleTitle {
    width: 1fr;
    height: auto;
    padding: 0;
    color: #e8edef;
    text-wrap: wrap;
}

.tool-args-collapsible > CollapsibleTitle:focus {
    background: transparent;
    color: #e8edef;
    text-style: none;
}

.tool-args-collapsible > CollapsibleTitle:hover,
.tool-args-collapsible > CollapsibleTitle:focus:hover {
    background: #17313a;
    color: #eef7f8;
}

.tool-args-collapsible > Contents {
    padding: 0 0 0 3;
}

.tool-args-editor {
    padding: 0 1;
    margin: 0 0 0 2;
    background: #101719;
    border-left: solid #d2a957;
    border-right: none;
    border-top: none;
    border-bottom: none;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-color: #d2a957;
    scrollbar-background: #20272b;
}

.tool-args-editor:focus {
    border-left: solid #7ce3dc;
    border-right: none;
    border-top: none;
    border-bottom: none;
}

.tool-output {
    width: 1fr;
    height: auto;
    padding: 0;
    background: transparent;
    color: #b8c1c7;
}

.tool-status {
    width: 1fr;
    height: 1;
    padding: 0;
    color: #98a5ac;
}

.message.tool-result {
    border: solid #6F7782;
    color: #CBD1D5;
}

.message.delegation {
    border: solid #C7A86B;
    color: #F0E1BD;
}

.message.subagent {
    border: solid #B7A4E8;
    color: #ECE7FF;
}

.message.success,
.message.summary {
    border: solid #7FBE72;
    color: #DDF2D7;
}
