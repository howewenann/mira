Screen {
    background: #0c0f10;
    color: #e8edef;
}

#app-shell {
    height: 100%;
    width: 100%;
}

#main-panel {
    width: 1fr;
    min-width: 24;
    height: 100%;
}

#session-sidebar {
    width: 42;
    min-width: 30;
    height: 100%;
    padding: 0 1;
    border: solid #2d5661;
    border-right: heavy #5bb8b1;
    background: #101516;
}

#session-sidebar-header {
    layout: horizontal;
    height: 1;
    width: 1fr;
    margin: 0 0 1 0;
}

#session-sidebar-title {
    width: 1fr;
    height: 1;
    color: #eef7f8;
    text-style: bold;
}

#new-chat {
    width: 7;
    min-width: 7;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: #7ce3dc;
    text-style: bold;
}

#new-chat:focus {
    background: #1b3036;
    color: #eef7f8;
}

#sessions {
    width: 1fr;
    height: 1fr;
    padding: 0;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#sessions > .session-row {
    height: 4;
    padding: 0 1;
    margin: 0 0 1 0;
    color: #b8c1c7;
}

#sessions > .session-row.--highlight,
#sessions > .session-row.active {
    background: #1b3036;
    color: #eef7f8;
}

#sessions > .session-row.active {
    border-left: solid #d2a957;
}

.session-label {
    height: 3;
}

.session-empty {
    color: #7d8b95;
}

#status-row {
    height: 1;
    width: 1fr;
    padding: 0 1;
    background: #17313a;
    color: #eef7f8;
}

#status {
    width: 1fr;
    height: 1;
}

#mcp-status-button,
#issues-button {
    width: 13;
    min-width: 13;
    max-width: 13;
    height: 1;
    padding: 0;
    border: none;
    text-style: bold;
}

#issues-button {
    display: none;
    background: #6b4f20;
    color: #fff0bd;
}

IssuesScreen {
    align: center middle;
    background: rgba(4, 7, 8, 0.72);
}

#issues-dialog {
    width: 76;
    max-width: 94%;
    height: 80%;
    min-height: 18;
    padding: 1 2;
    border: heavy #d2a957;
    background: #101516;
}

#issues-title-row {
    height: 3;
    width: 1fr;
}

#issues-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: #fff0bd;
    text-style: bold;
}

#issues-scroll {
    height: 1fr;
    scrollbar-color: #d2a957;
    scrollbar-background: #20272b;
}

#mcp-status-button {
    display: none;
    background: #5bb8b1;
    color: #081112;
}

#mcp-status-button:focus {
    background: #7ce3dc;
    color: #081112;
}

#telemetry-row {
    height: 1;
    width: 1fr;
    padding: 0 1;
    background: #101b1f;
    color: #b8c1c7;
}

#model-settings-button {
    width: auto;
    max-width: 60%;
    min-width: 14;
    height: 1;
    border: none;
    padding: 0 1;
    content-align: left middle;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    background: #8897E8;
    color: #0C0F10;
    text-style: bold;
}

#model-settings-button:focus {
    background: #A8B3FF;
    color: #0C0F10;
    text-style: bold;
}

#telemetry-values {
    width: 1fr;
    height: 1;
    content-align: right middle;
}

MCPPanelScreen {
    align: center middle;
    background: rgba(4, 7, 8, 0.72);
}

#mcp-dialog {
    width: 88;
    max-width: 96%;
    height: 84%;
    min-height: 18;
    padding: 1 2;
    border: heavy #5bb8b1;
    background: #101516;
}

#mcp-title-row { height: 3; }
#mcp-title { width: 1fr; height: 3; content-align: left middle; color: #d6fff6; text-style: bold; }
#mcp-scroll { height: 1fr; scrollbar-color: #5bb8b1; scrollbar-background: #122023; }

#mcp-actions {
    height: 3;
    align-horizontal: right;
}

#mcp-actions Button {
    min-width: 12;
    margin-left: 1;
}

.mcp-server-card {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid #3e5962;
    background: #151f22;
}

.mcp-server-top {
    width: 1fr;
    height: 1;
}

.mcp-server-header {
    width: 1fr;
    height: 1;
    border: none;
    background: #1b3036;
    color: #eef7f8;
    text-align: left;
    content-align: left middle;
    text-style: bold;
}
.mcp-server-header:focus { background: #25434b; }

.mcp-status-badge {
    width: auto;
    min-width: 14;
    max-width: 26;
    height: 1;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
    background: #263137;
    color: #c6d0d5;
}

.mcp-status-badge.available { background: #194b32; color: #a9f0b1; }
.mcp-status-badge.warning { background: #5a451e; color: #fff0ad; }
.mcp-status-badge.failed { background: #5b272a; color: #ffb3b3; }
.mcp-status-badge.disabled { background: #30383d; color: #aeb8be; }
.mcp-status-badge.transient { background: #263f60; color: #bcd1f5; }

.mcp-counts {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #eef7f8;
}

.mcp-controls { height: 1; align-horizontal: right; }
.mcp-controls Button {
    min-width: 10;
    height: 1;
    margin-left: 1;
    padding: 0 1;
    border: none;
}
.mcp-details { height: auto; margin-top: 1; padding: 0 1; color: #b8c1c7; }
.mcp-detail-section { height: auto; padding: 1; margin-bottom: 1; background: #101719; color: #c4cdd2; }
.mcp-error-block { height: auto; padding: 1; border-left: solid #d95757; background: #301d1f; color: #ffb3b3; }

#chat-log {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: solid #2d5661;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#autocomplete-input {
    width: 100%;
    height: auto;
}

#autocomplete-options {
    display: none;
    width: 100%;
    height: auto;
    max-height: 12;
    border: solid #5bb8b1;
    background: #101516;
    color: #e8edef;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#autocomplete-options > .option-list--option-highlighted {
    background: #1b3036;
    color: #eef7f8;
    text-style: bold;
}

#prompt {
    height: 5;
    border: heavy #5bb8b1;
    padding: 0 1;
    background: transparent;
}

#subagents-panel {
    display: none;
    height: auto;
    max-height: 14;
    padding: 0 1 1 1;
    border-top: solid #B7A4E8;
    background: #101516;
    color: #ECE7FF;
}

#subagents-panel-header-row {
    height: 1;
    width: 1fr;
}

#subagents-panel-header {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
}

.subagents-panel-action {
    width: 5;
    min-width: 3;
    height: 1;
    margin: 0;
    border: none;
    background: #101516;
    color: #d2d8dc;
}

.subagents-panel-action:focus {
    color: #eef7f8;
}

#subagents-panel-body {
    height: auto;
    max-height: 11;
    width: 1fr;
}

#subagents-groups-scroll {
    width: 25%;
    min-width: 15;
    max-width: 28;
    height: auto;
    max-height: 11;
    padding: 0 1 0 0;
    margin: 0 1 0 0;
    border-right: solid #4a5360;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#subagents-tasks-scroll {
    width: 1fr;
    height: auto;
    max-height: 11;
    overflow-x: hidden;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#subagents-tasks {
    width: 100%;
    text-wrap: nowrap;
    text-overflow: clip;
}

#prompt-panel {
    width: 100%;
    height: auto;
    max-height: 90%;
    padding: 1;
    background: #11181b;
    border: solid #d2a957;
}

#prompt-panel-title {
    height: 1;
    margin-bottom: 1;
    text-style: bold;
    color: #eef7f8;
}

#prompt-panel-body {
    height: auto;
    min-height: 3;
    max-height: 6;
    padding: 0 1;
    border: solid #3c4a50;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

#prompt-panel-message {
    color: #e8edef;
}

#prompt-panel-input {
    height: 3;
    margin-top: 1;
    border: heavy #5bb8b1;
    padding: 0 1;
    background: #101516;
}

#prompt-panel-editor {
    height: 8;
    margin-top: 1;
    border: solid #4a5360;
}

#prompt-panel-buttons {
    layout: vertical;
    width: 100%;
    height: auto;
    margin-top: 1;
}

.vertical-choices #prompt-panel-buttons {
    max-height: 4;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

Horizontal.prompt-panel-button-row {
    layout: horizontal;
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
}

Button.prompt-panel-button {
    min-width: 12;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    content-align: center middle;
    text-align: center;
}

Button.prompt-panel-button:focus {
    background: #d2a957;
    color: #0c0f10;
    text-style: bold;
}

.vertical-choices Button.prompt-panel-button {
    content-align: left middle;
    text-align: left;
}

.message {
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid #3c4a50;
    color: #e8edef;
}

.message.user {
    border: solid #D6B35A;
}

.message.assistant,
.message.startup {
    border: solid #5BB8B1;
}

.message.assistant {
    height: auto;
}

.assistant-body {
    height: auto;
}

.assistant-actions {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin-top: 1;
    align-horizontal: left;
}

Button.assistant-copy {
    width: 10;
    min-width: 10;
    max-width: 10;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    content-align: center middle;
    text-align: center;
    background: #151f22;
    color: #b8d6d5;
    text-style: none;
}

Button.assistant-copy:focus,
Button.assistant-copy:hover {
    border: none;
    background: #1b3036;
    color: #eef7f8;
    text-style: none;
}

.message.reasoning {
    border: solid #82909A;
    color: #B8C2C9;
}

.message.status {
    border: solid #7D9BD1;
    color: #DCE6FA;
}

.message.info {
    border: solid #6CB6FF;
    color: #DCEEFF;
}

.message.warning {
    border: solid #E07A3F;
    color: #F5C7A9;
}

.message.error {
    border: solid #D96B66;
    color: #FFD9D6;
}

.message.muted {
    border: solid #7A858C;
    color: #AEB8BE;
}

.message.heading {
    border: solid #5bb8b1;
    color: #eef7f8;
}

.message.plan {
    height: auto;
    border: solid #A0B86B;
    color: #EEF5D8;
}

.plan-body {
    height: auto;
}

.plan-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

Button.plan-action {
    min-width: 12;
    width: auto;
    height: 1;
    min-height: 1;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

Button.plan-action:focus {
    background: #d2a957;
    color: #0c0f10;
    text-style: bold;
}

.message.goal {
    height: auto;
    border: solid #C58FD6;
    color: #F1DCF5;
}

.message.correction {
    border: solid #7D9BD1;
    color: #DCE6FA;
}

.message.rubric {
    border: solid #C58FD6;
    color: #F1DCF5;
}

.goal-body {
    height: auto;
}

.goal-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

Button.goal-action {
    min-width: 12;
    width: auto;
    height: 1;
    min-height: 1;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

Button.goal-action:focus {
    background: #C58FD6;
    color: #0c0f10;
    text-style: bold;
}

.message.command {
    border: solid #6F7782;
    color: #CBD1D5;
}

#settings-overlay {
    layer: overlay;
    width: 100%;
    height: 100%;
    align: center middle;
    background: #0c0f10 70%;
}

#settings-window {
    width: 96;
    max-width: 98%;
    height: auto;
    max-height: 92%;
    padding: 1 3 1 3;
    border: solid #5bb8b1;
    background: #101516;
}

.settings-top-row {
    height: 3;
    width: 1fr;
}

.settings-title {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
    color: #eef7f8;
    text-style: bold;
}

.panel-close {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 0 0 0 1;
    color: #d2d8dc;
    background: transparent;
    border: heavy #56616a;
}

.panel-close:focus {
    color: #d2d8dc;
    background: transparent;
    border: heavy #56616a;
}

.settings-body {
    height: auto;
    scrollbar-color: #5bb8b1;
    scrollbar-background: #122023;
}

.settings-section {
    height: 1;
    margin: 0;
    width: auto;
    padding: 0;
    text-style: bold;
    content-align: left middle;
}

.settings-section.system {
    color: #d18aa6;
}

.settings-section.inbuilt {
    color: #d2a957;
}

.settings-section.custom {
    color: #7FBE72;
}

.settings-section.inbuilt,
.settings-section.execute-env {
    margin-top: 1;
}

.settings-section.system,
.settings-section.custom {
    margin-top: 2;
}

.settings-section.execute-env {
    color: #cba6f7;
}

.settings-section.model-context {
    color: #D9956A;
    margin-top: 2;
}

.settings-section.model-assignments {
    color: #8897E8;
    margin-top: 1;
}

.settings-section.subagents {
    color: #93A4C3;
    margin-top: 2;
}

.settings-row {
    height: 2;
    width: auto;
}

.settings-child-label {
    padding-left: 3;
    color: #5bb8b1;
}

.settings-wide-row {
    height: 3;
}

.settings-header-row {
    height: 1;
}

.settings-label,
.settings-column-label.name {
    height: 1fr;
    content-align: left middle;
    color: #7ce3dc;
}

.settings-label {
    width: 30;
    min-width: 20;
}

.settings-column-label.name,
.settings-policy-row > .settings-label,
.settings-value-row > .settings-label {
    width: 44;
    min-width: 20;
}

.settings-column-label {
    color: #aeb8be;
    text-style: bold;
}

.settings-column-label.enabled,
.settings-column-label.always,
.settings-column-label.plan {
    width: 12;
    min-width: 12;
    margin: 0 2 0 0;
    height: 1fr;
    content-align: center middle;
}

.settings-mode {
    width: 12;
    min-width: 12;
    margin: 0 2 0 0;
    height: 1fr;
    content-align: center middle;
}

.settings-toggle {
    min-width: 12;
    width: 12;
    height: 1;
    margin: 0 2 1 0;
    border: none;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

.settings-toggle.on {
    color: #e8fffb;
    background: #14524f;
    border: none;
}

.settings-toggle.off {
    color: #d2d8dc;
    background: #20272b;
    border: none;
}

.settings-toggle.locked {
    color: #7a858c;
    background: #151a1d;
    border: none;
}

.settings-toggle:focus {
    border: none;
    text-style: bold;
}

.settings-toggle.on:focus {
    color: #e8fffb;
    background: #14524f;
}

.settings-toggle.off:focus {
    color: #d2d8dc;
    background: #20272b;
}

.settings-empty,
.settings-status {
    color: #aeb8be;
}

.settings-select {
    width: 56;
    min-width: 36;
    height: 3;
    margin: 0 1 0 0;
}

.settings-select > SelectCurrent {
    border: solid #56616a;
    color: #e8fffb;
    background: #151a1d;
}

.settings-select > SelectCurrent > Static#label {
    color: #e8fffb;
}

.settings-select:focus > SelectCurrent {
    border: solid #5bb8b1;
}

.settings-select > SelectOverlay,
.settings-select > SelectOverlay:focus {
    border: solid #5bb8b1;
    color: #e8fffb;
    background: #151a1d;
}

.settings-select > SelectOverlay > .option-list--option-highlighted,
.settings-select > SelectOverlay:focus > .option-list--option-highlighted {
    color: #e8fffb;
    background: #14524f;
    text-style: bold;
}

.settings-input {
    width: 56;
    min-width: 36;
    height: 3;
    margin: 0 1 0 0;
    border: solid #56616a;
    color: #e8fffb;
    background: #151a1d;
}

.settings-input:focus {
    border: solid #5bb8b1;
}

.settings-input:disabled {
    border: solid #3c4a50;
    color: #7a858c;
}

.rubric-iterations-row {
    height: 2;
}

.settings-input.rubric-iterations-input,
.settings-input.planning-response-status-retries-input {
    width: 12;
    min-width: 12;
    height: 1;
    margin: 0 2 1 0;
    border: none;
}

.settings-input.settings-context-limit-input {
    width: 24;
    min-width: 24;
}

.settings-context-row > .settings-label {
    width: 30;
}

.settings-subagent-header > .settings-column-label.name,
.settings-subagent-row > .settings-label {
    width: 28;
    min-width: 20;
    margin-right: 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.settings-subagent-row > .settings-toggle {
    margin: 1 2 1 0;
}

.settings-subagent-header > .settings-column-label.model,
.settings-subagent-model-select {
    width: 1fr;
    min-width: 22;
}

.settings-subagent-header > .settings-column-label.model {
    max-width: 44;
}

.settings-subagent-model-select {
    max-width: 43;
}

.settings-subagent-header > .settings-column-label.model {
    height: 1fr;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

.settings-subagent-model-select > SelectCurrent > Static#label {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#settings-tabs { height: 3; }
.settings-tab { width: 18; height: 3; border: none; background: #151a1d; color: #aeb8be; }
.settings-tab.active { background: #1b3036; color: #eef7f8; text-style: bold; }
.settings-body { height: 1fr; }
.settings-mcp-server-group {
    height: auto;
    margin: 1 0 0 0;
    background: transparent;
}

.settings-mcp-server-group.first {
    margin-top: 2;
}

.settings-mcp-server-title {
    height: 1;
    color: #6CB6FF;
    text-style: bold;
}

.settings-mcp-tool-header {
    margin-top: 1;
}

.settings-mcp-tool-empty {
    height: 2;
}

.settings-custom-tool-row > .settings-label,
.settings-mcp-tool-row > .settings-label {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.settings-custom-tool-header > .settings-column-label.name,
.settings-custom-tool-row > .settings-label,
.settings-mcp-server-header > .settings-column-label.name,
.settings-mcp-server-policy-row > .settings-label,
.settings-mcp-tool-header > .settings-column-label.name,
.settings-mcp-tool-row > .settings-label {
    width: 42;
    min-width: 18;
    margin-right: 2;
}

.settings-input.rubric-iterations-input:focus,
.settings-input.rubric-iterations-input:disabled,
.settings-input.planning-response-status-retries-input:focus,
.settings-input.planning-response-status-retries-input:disabled {
    border: none;
}

.settings-status {
    height: 1;
    margin-top: 1;
}

.message.tool-call {
    border: solid #8FA3B8;
}

.message.tool-result {
    border: solid #6F7782;
    color: #CBD1D5;
}

.message.delegation {
    border: solid #C7A86B;
    color: #F0E1BD;
}

.message.subagent {
    border: solid #B7A4E8;
    color: #ECE7FF;
}

.message.success,
.message.summary {
    border: solid #7FBE72;
    color: #DDF2D7;
}
